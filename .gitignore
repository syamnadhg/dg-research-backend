__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
release/
.env
.dg-supervisor.env

# Firebase Admin SDK key — NEVER commit. Sammy emails this personally.
# Drop it at: research-automate/firebase-service-account.json
firebase-service-account.json

# Per-machine local state — backend writes these on --setup / --serve.
pipe_config.json
research_config.json
device_config.json
run_analytics.json
backend.log
backend.err.log
daemon.log
daemon.err.log

# Playwright user data (logged-in browser sessions) stays local.
.playwright-profile/
playwright-profile/

# Pipeline output — not source. Keep the README so the queues/{run}/
# schema stays discoverable in the repo. (tracks/ removed 2026-04-29 —
# the directory tree is gone and so are the `tracks/*` ignore lines.)
queues/*
!queues/README.md

# Runtime debug logs from `python research.py --serve 2>&1 | tee logs/...`
# and one-off resume_phase2_*.log dumps. Local-only.
logs/
*.log

# Scratch — design notes, hotspot maps, throwaway test scripts. Local-only;
# anything worth keeping graduates to a real file in the repo root.
scratch/

# Running sr.py straight from this checkout (rather than a deployed Hermes
# layout) makes _scripts_dir() fall back to the bundle itself, so the watchdog
# arming writes its cron store here. Real hosts write to HERMES_HOME/cron.
agent/facade/skill/cron/

# Vision fixtures — hotspot screenshots may contain authed-session UI
# (email addresses, account chips). Captured locally during E2E via
# `python vision_test.py --capture NAME` (manual) AND auto-harvested
# into tests/fixtures/vision/auto/<hotspot>/ by vision.py when
# DG_VISION_FIXTURE_AUTO=1. The README stays in the repo so the schema
# is discoverable.
tests/fixtures/vision/*.png
tests/fixtures/vision/*.json
tests/fixtures/vision/auto/

# macOS Finder metadata and per-machine agent settings — local noise.
.DS_Store
.claude/

# uv lockfiles — deliberately NOT tracked. Neither package resolves dependencies
# from a lock at build time: the wheels inherit Requires-Dist from
# pyproject.toml's [project].dependencies (via `pip wheel . --no-deps`), and the
# dependency set is already pinned and guarded by tests/released_deps.json +
# tests/test_release_dep_version_guard.py. So a tracked lock would add churn on
# every machine without protecting anything the guard does not already cover.
# Ignored rather than left merely untracked because they existed on the Mac but
# not on the Windows box, which is one stray `git add` away from a divergence.
uv.lock
agent/uv.lock
