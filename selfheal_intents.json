    "type": "toggle",
    "irreversible": false,
    "region": "form",
    "outcome_predicate": "cgpt_state:active",
    "signal_hints": {
      "accessible_name": "deep research",
      "role": [
        "button",
        "menuitem",
        "menuitemradio"
      ]
    },
    "tier_sequence": [
      "registry",
      "builtin",
      "heal",
      "vision",
      "cua"
    ]
  },
